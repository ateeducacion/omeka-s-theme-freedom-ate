<?php
$translate = $this->plugin('translate');
$navDepth = (int) $this->themeSetting('nav_depth') ? (int) $this->themeSetting('nav_depth') -1 : -1;
$topBarLogo = $this->themeSetting('top_bar_logo');
// The URL has no usable default: the installation root just redirects to the
// default site, so the link is only shown once an explicit URL is configured.
$landingUrl = $this->SafeUrl($this->themeSetting('landing_link_url'));
$landingLink = $this->themeSetting('landing_link')
    && $this->themeSetting('landing_link_logo')
    && null !== $landingUrl;
?>

<header class="main-header">

	<div class="main-header__top-bar container">
		<?php if ($topBarLogo || $landingLink): ?>
			<div class="main-header__top-bar-brand">
				<?php if ($topBarLogo): ?>
					<img class="main-header__top-bar-logo" src="<?php echo $this->themeSettingAssetUrl('top_bar_logo'); ?>" alt="" />
				<?php endif; ?>
				<?php if ($landingLink): ?>
					<a class="main-header__landing-link" href="<?php echo $this->escapeHtmlAttr($landingUrl); ?>" aria-label="<?php echo $this->escapeHtmlAttr($translate('Landing page')); ?>">
						<img src="<?php echo $this->themeSettingAssetUrl('landing_link_logo'); ?>" alt="" />
					</a>
				<?php endif; ?>
			</div>
		<?php endif; ?>
		<a class="main-header__advanced-search" href="<?php echo $site->url() . '/item/search'; ?>"><?php echo $translate('Advanced search'); ?></a>
		<div class="main-header__actions-group">
			<div class="main-header__search-form">
				<?php echo $this->partial('common/search-form'); ?>
			</div>
			<?php if ($userBar): ?>
				<?php echo $userBar ?>
			<?php endif; ?>
		</div>
	</div>
	<hr class="alignfull">

	<div class="main-header__main-bar container">
		<div class="main-header__site-title">
			<a href="<?php echo $site->url(); ?>">
			<?php if ($this->themeSetting('logo')): ?>
				<img src="<?php echo $this->themeSettingAssetUrl('logo'); ?>" alt="<?php echo $this->escapeHtml( $site->title() ); ?>" />
			<?php endif; ?>
				<span class="main-header__site-name"><?php echo $this->escapeHtml( $site->title() ); ?></span>
			</a>
		</div>

		<?php if ($this->themeSetting('header_menu')): ?>
		<nav class="main-navigation">
			<div class="main-navigation__container">
				<?php
				echo $site->publicNav()->menu()->renderMenu(null, [
					'addClassToListItem' => true,
					'maxDepth' => $navDepth
				]);
				?>
			</div>
			<div class="main-navigation__toggle"
				 tabindex="0"
				 role="button"
				 aria-expanded="false"
				 aria-controls="menu-drawer"
				 aria-labelledby="menu-backer">
				<span></span>
				<span></span>
				<span></span>
			</div>
		</nav>

		<?php echo $this->partial('common/menu-drawer'); ?>
		<?php endif; ?>
	</div>

</header>
